# 줄바꿈 정규화
* text=auto

# 셸 스크립트와 git 훅은 항상 LF.
# CRLF 로 체크아웃되면 Linux/macOS 와 CI 에서 "bad interpreter: /bin/sh^M" 으로 죽는다.
*.sh            text eol=lf
.githooks/*     text eol=lf

# Unity 텍스트 에셋 (Force Text 직렬화 전제)
*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.unity     text merge=unityyamlmerge eol=lf
*.prefab    text merge=unityyamlmerge eol=lf
*.asset     text merge=unityyamlmerge eol=lf
*.mat       text merge=unityyamlmerge eol=lf
*.anim      text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta      text merge=unityyamlmerge eol=lf

# 바이너리 (LFS 를 켤 경우 아래 줄들을 filter=lfs diff=lfs merge=lfs -text 로 교체)
*.png       binary
*.jpg       binary
*.psd       binary
*.fbx       binary
*.blend     binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.ttf       binary
*.otf       binary
